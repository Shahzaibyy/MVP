# ─────────────────────────────────────────────────────────────────────────────
#  Security MVP – Environment Variables
#  Copy this file:  cp .env.example .env
#  Then fill in your real Azure Service Principal values.
#  NEVER commit the real .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Service Principal (for Prowler) ─────────────────────────────────────
# Create one:  az ad sp create-for-rbac --name "security-mvp" --role Reader
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# ── Trivy – which image to scan ───────────────────────────────────────────────
# Use an old image to generate showcase vulnerabilities:
TRIVY_IMAGE=python:3.7-slim
# TRIVY_IMAGE=node:10-slim    # Even more CVEs for demo

# ── Database (change in production) ──────────────────────────────────────────
DB_PASSWORD=StrongPass123!
